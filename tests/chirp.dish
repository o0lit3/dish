[
    v = 1                        ## 1
    "$v"                         ## "1"
    "a$v b"                      ## "a1 b"
    "($v)"                       ## "(1)"
    "$v["                        ## "1["
    "$(v + 1)"                   ## "2"
    "\$v"                        ## "$v"
    "$v\$v"                      ## "1$v"
    "end$"                       ## "end$"
    "$ v"                        ## "$ v"
    "a\\b"                       ## "a\\b"
    ["20% off"]                  ## ["20% off"]
    {pct: "50%"}                 ## {"pct": "50%"}
    ((1..18)*:i("v$i" = i)).sum  ## 171
    v1 + v18                     ## 19
    $1 ?? "none"                 ## "none"
    [0, 1, 2].map:n{"a"+n: n}    ## [{"a": 0}, {"b": 1}, {"c": 2}]
    ([0, 1, 2].map:n{a: n}, n)   ## null
    2 ^ -60                      ## 0.000000000000000000867361737988403547205962240695953369140625
    1/3                          ## 0.33333333333333333
    [inf, 0 - inf]               ## ["inf", "-inf"]
]
