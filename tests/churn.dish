[
    v = 1                       ## 1
    "$v"                        ## "1"
    "a$v b"                     ## "a1 b"
    "($v)"                      ## "(1)"
    "$v["                       ## "1["
    "$(v + 1)"                  ## "2"
    "\$v"                       ## "$v"
    "$v\$v"                     ## "1$v"
    "end$"                      ## "end$"
    "$ v"                       ## "$ v"
]
