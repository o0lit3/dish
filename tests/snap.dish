[
    7.prime            ## true
    9.prime            ## false
    7.sqrt @ 2         ## 2.65
    9.sqrt             ## 3
    7.log @ 2          ## 1.95
    pi = 3.1415        ## 3.1415
    (pi / 4).sin @ 4   ## 0.7071
    (pi / 4).cos @ 4   ## 0.7071
    (pi / 4).tan @ 4   ## 1
    (0.7071).asin @ 4  ## 0.7854
    (0.7071).acos @ 4  ## 0.7854
    (1.0000).atan @ 4  ## 0.7854
    inf.sqrt           ## inf
    0.log              ## -inf
    (3^80).sqrt        ## 12157665459056928801
    [9, 4].sqrt        ## [3, 2]
    {a: 9}.sqrt        ## {"a": 3}
    d = 1787149800     ## 1787149800
    d.year             ## 2026
    d.date             ## "2026-08-19T14:30:00Z"
    d.date('%Y-%m-%d') ## "2026-08-19"
    7.days             ## 604800
    0.5.days           ## 43200
    (0 - 86400).date   ## "1969-12-31T00:00:00Z"
    now > 0            ## true
]
