[
    7.prime            ## true
    9.prime            ## false
    7.sqrt @ 2         ## 2.65
    9.sqrt             ## 3
    7.log @ 2          ## 1.95
    pi = 3.1415        ## 3.1415
    (pi / 4).sin @ 4   ## 0.7071
    (pi / 4).cos @ 4   ## 0.7071
    (pi / 4).tan @ 4   ## 1
    (0.7071).asin @ 4  ## 0.7854
    (0.7071).acos @ 4  ## 0.7854
    (1.0000).atan @ 4  ## 0.7854
    inf.sqrt           ## inf
    0.log              ## -inf
    (3^80).sqrt        ## 12157665459056928801
    [9, 4].sqrt        ## [3, 2]
    {a: 9}.sqrt        ## {"a": 3}
]
