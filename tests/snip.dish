[
    'apple'.digit                          ## false
    '0123'.digit                           ## true
    'apple'.letter                         ## true
    '0123'.letter                          ## false
    'apple'.consonant                      ## false
    'banana'.consonant                     ## true
    'apple'.upper                          ## false
    'Apple'.upper                          ## true
    'apple'.lower                          ## true
    ' '.space                              ## true
    \'3.14'                                ## "3\\.14"
    'a(b'.escape                           ## "a\\(b"
    'a1'.capture('\d')                     ## [["1"]]
    'bin'.scan('[in]')                     ## ["i", "n"]
    'bin'.match('i.')                      ## "in"
    'aaa'.sub('a', 'b')                    ## "baa"
    'bin'.replace('n', 'g')                ## "big"
    ['a'].replace('a','o')                 ## ["o"]
    'a b'.cut('\s')                        ## ["a", "b"]
    'a1'.replace('(a)(1)', :m:x:y(y + x))  ## "1a"
    'a1'.extract('(?<n>\d)')               ## [{"n": "1"}]
    {a: 'apple'}.match('pp')               ## {"a": "pp"}
    {a: 'apple'}.scan('p')                 ## {"a": ["p", "p"]}
    {a: 'a1'}.capture('(a)(\d)')           ## {"a": [["a1", "a", "1"]]}
    {a: 'a1'}.extract('(?<n>\d)')          ## {"a": [{"n": "1"}]}
    {a: 'a b'}.cut('\s')                   ## {"a": ["a", "b"]}
    {a: 'apple'}.replace('p', '')          ## {"a": "ale"}
    {a: 'a(b'}.escape                      ## {"a": "a\\(b"}
    ['a', '7'].vowel                       ## [true, false]
    {x: 'a', y: '7'}.digit                 ## {"x": false, "y": true}
    '2026-08-19'.stamp                     ## 1787097600
    '2026-08-19T16:30:00+02:00'.stamp      ## 1787149800
    '19/08/2026'.stamp('%d/%m/%Y')         ## 1787097600
    'nope'.stamp                           ## null
    ['a(b'].escape                         ## ["a\\(b"]
]
